{
  "manifest_version": 3,
  "name": "GWA at a Glance",
  "description": "View your GWAs at a glance!",
  "version": "1.1",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://alabsms.bulsu.edu.ph/grades*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://alabsms.bulsu.edu.ph/grades*"],
      "js": ["main.js"],
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kioijimo@github.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
